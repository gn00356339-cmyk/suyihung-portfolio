---
export interface Props {
  title: string;
  description: string;
  keywords?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, keywords = [], jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Su Yi-Hung',
  alternateName: '蘇益弘',
  jobTitle: 'AI Landing Practitioner / Site Engineer',
  description:
    'Non-engineer who landed AI into a traditional building-materials distributor, shipped 30+ iOS apps solo, ran a daily content automation pipeline, and turned 20 years of on-site renovation knowledge into a transmissible knowledge base.',
  knowsAbout: [
    'AI workflow design',
    'iOS app development with AI assistance',
    'Content automation pipelines',
    'Traditional industry digitization',
    'Multi-agent orchestration',
    'Renovation domain expertise',
  ],
  url: 'https://suyihung.pages.dev',
  email: 'gn00356339@gmail.com',
};

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allLd = [personLd, ...extraLd];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={new URL('/og-card.svg', Astro.site).toString()} />
    <meta property="og:site_name" content="Su Yi-Hung — AI Landing Practitioner" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-card.svg', Astro.site).toString()} />
    <meta name="generator" content={Astro.generator} />
    {allLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
    <style is:global>
      :root {
        --fg: #0f1419;
        --muted: #5a6470;
        --bg: #f7f7f4;
        --paper: #ffffff;
        --accent: #1d4e6b;
        --accent-soft: #e8eef2;
        --border: #d6d3cc;
        --code-bg: #ecebe5;
        --serif: 'Iowan Old Style', 'Source Han Serif TC', 'Noto Serif TC', 'PingFang TC', Georgia, serif;
        --sans: -apple-system, BlinkMacSystemFont, 'Inter', 'PingFang TC', 'Noto Sans TC', sans-serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--sans);
        color: var(--fg);
        background: var(--bg);
        line-height: 1.75;
        font-size: 17px;
      }
      header.site {
        border-bottom: 1px solid var(--border);
        padding: 1.1rem 1.25rem;
        background: var(--paper);
      }
      header.site nav {
        max-width: 820px;
        margin: 0 auto;
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        font-size: 0.95rem;
        align-items: baseline;
      }
      header.site nav a { color: var(--fg); text-decoration: none; }
      header.site nav a:hover { color: var(--accent); }
      header.site .brand { font-family: var(--serif); font-weight: 700; font-size: 1.15rem; letter-spacing: 0.01em; }
      header.site .brand small { color: var(--muted); font-weight: 400; font-size: 0.85rem; margin-left: 0.4rem; }
      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2.5rem 1.4rem 4rem;
      }
      h1 {
        font-family: var(--serif);
        font-size: 2.2rem;
        line-height: 1.25;
        margin: 1rem 0 0.6rem;
        letter-spacing: -0.01em;
      }
      h2 {
        font-family: var(--serif);
        font-size: 1.45rem;
        margin-top: 2.8rem;
        margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
      }
      h3 {
        font-size: 1.1rem;
        margin-top: 1.8rem;
        color: var(--accent);
      }
      p { margin: 0.9rem 0; }
      a { color: var(--accent); }
      blockquote {
        border-left: 3px solid var(--accent);
        margin: 1.2rem 0;
        padding: 0.4rem 1.1rem;
        background: var(--accent-soft);
        font-style: italic;
        color: var(--muted);
      }
      code { background: var(--code-bg); padding: 0.1rem 0.35rem; border-radius: 3px; font-size: 0.9em; }
      .lede {
        font-size: 1.18rem;
        line-height: 1.6;
        color: var(--muted);
        font-family: var(--serif);
        margin: 1rem 0 1.6rem;
      }
      .lang {
        color: var(--muted);
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-top: 2.5rem;
        border-top: 1px solid var(--border);
        padding-top: 1.5rem;
      }
      .meta {
        font-size: 0.85rem;
        color: var(--muted);
      }
      ul, ol { padding-left: 1.4rem; }
      li { margin: 0.35rem 0; }
      .case-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.2rem;
        margin: 1.8rem 0;
      }
      .case-card {
        border: 1px solid var(--border);
        padding: 1.3rem 1.4rem;
        border-radius: 6px;
        background: var(--paper);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }
      .case-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
      }
      .case-card .num {
        font-family: var(--serif);
        color: var(--accent);
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .case-card h3 {
        margin: 0.4rem 0 0.6rem;
        color: var(--fg);
        font-family: var(--serif);
        font-size: 1.15rem;
      }
      .case-card a { text-decoration: none; color: inherit; }
      .case-card .proves {
        font-size: 0.88rem;
        color: var(--muted);
        margin-top: 0.6rem;
      }
      footer.site {
        border-top: 1px solid var(--border);
        padding: 2rem 1.25rem;
        font-size: 0.85rem;
        color: var(--muted);
        text-align: center;
        background: var(--paper);
      }
      footer.site a { color: var(--muted); }
      .hero-quote {
        font-family: var(--serif);
        font-size: 1.05rem;
        color: var(--muted);
        border-left: 2px solid var(--border);
        padding-left: 1.2rem;
        margin: 1.5rem 0;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <nav>
        <a href="/" class="brand">Su Yi-Hung <small>蘇益弘</small></a>
        <a href="/#cases">Cases</a>
        <a href="/cases/case1">Case 1</a>
        <a href="/cases/case2">Case 2</a>
        <a href="/cases/case3">Case 3</a>
        <a href="/cases/case4">Case 4</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      © Su Yi-Hung 蘇益弘 · AI Landing Practitioner ·
      <a href="mailto:gn00356339@gmail.com">gn00356339@gmail.com</a>
    </footer>
  </body>
</html>
